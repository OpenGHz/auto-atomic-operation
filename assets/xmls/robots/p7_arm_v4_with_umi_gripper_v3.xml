<?xml version="1.0" encoding="utf-8"?>
<mujoco model="p7_arm_v4_umi_gripper_v3">
  <compiler angle="radian" balanceinertia="true" meshdir="../../meshes/p7_arm_v4"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" iterations="100" cone="elliptic"/>

  <!-- The arm geometry, link transforms, and joint limits are from Praxis'
       KJ6310 V4 P7 asset. Arm inertial entries, defaults, and the UMI v3
       subtree intentionally remain copied from the existing V3 XML. -->
  <default>
    <default class="p7_arm_v4">
      <joint damping="3" armature="0.03" frictionloss="0.05"/>
      <geom solref="0.003 1" solimp="0.95 0.99 0.001" margin="0.002"/>
    </default>
  </default>

  <contact>
    <exclude body1="link1" body2="link2"/>
    <exclude body1="link2" body2="link3"/>
    <exclude body1="link3" body2="link4"/>
    <exclude body1="link4" body2="link5"/>
    <exclude body1="link5" body2="link6"/>
    <exclude body1="link6" body2="link7"/>
    <exclude body1="link5" body2="link7"/>
    <exclude body1="link7" body2="umi_gripper_mount"/>
    <exclude body1="link7" body2="eef_base_link"/>
    <exclude body1="link7" body2="eef_L11"/>
    <exclude body1="link7" body2="eef_L21"/>
  </contact>

  <asset>
    <mesh name="base_link" content_type="model/stl" file="base_link.STL"/>
    <mesh name="link1" content_type="model/stl" file="link1.STL"/>
    <mesh name="link2" content_type="model/stl" file="link2.STL"/>
    <mesh name="link3" content_type="model/stl" file="link3.STL"/>
    <mesh name="link4" content_type="model/stl" file="link4.STL"/>
    <mesh name="link5" content_type="model/stl" file="link5.STL"/>
    <mesh name="link6" content_type="model/stl" file="link6.STL"/>
    <mesh name="link7" content_type="model/stl" file="link7.STL"/>
    <mesh name="tool" content_type="model/stl" file="tool.STL"/>
    <model name="umi_gripper_v3" file="umi_gripper_v3.xml"/>
  </asset>

  <worldbody>
    <body name="p7_mount" pos="1 0.4 -0.3" childclass="p7_arm_v4">
      <!-- <geom name="table_robot" pos="0 0 -0.5" size="0.15 0.2 0.5" type="box" contype="1"/> -->

      <geom type="mesh" rgba="0.75294 0.75294 0.75294 1" mesh="base_link" contype="0" conaffinity="0"/>

      <body name="link1" pos="0 0 0.0662" gravcomp="1">
        <inertial pos="-0.0000049800 -0.0066806700 -0.0038860200" mass="0.8674122500" fullinertia="0.0011053300 0.0009584200 0.0008760500 0.0000014200 -0.0000040500 0.0000139300"/>
        <joint name="joint1" pos="0 0 0" axis="0 0 1" range="-2.9669 2.9669"/>
        <geom type="mesh" rgba="0.75294 0.75294 0.75294 1" mesh="link1"/>

        <body name="link2" quat="0.2988329513 0.2988365616 0.6408571526 -0.6408569939" gravcomp="1">
          <inertial pos="-0.0000333900 -0.0761963800 0.0010885100" mass="0.7307583200" fullinertia="0.0010906000 0.0006664300 0.0009529500 -0.0000016500 -0.0000013600 -0.0000467300"/>
          <joint name="joint2" pos="0 0 0" axis="0 0 1" range="-2.8798 0.83775"/>
          <geom type="mesh" rgba="0.75294 0.75294 0.75294 1" mesh="link2"/>

          <body name="link3" pos="0 -0.249 0" quat="0.7071054825 0.7071080799 0 0" gravcomp="1">
            <inertial pos="0.0061775800 0.0014579900 -0.0743792800" mass="0.2608916100" fullinertia="0.0007031400 0.0006063700 0.0002296400 0.0000019500 0.0000067100 -0.0000310000"/>
            <joint name="joint3" pos="0 0 0" axis="0 0 1" range="-2.9669 2.9669"/>
            <geom type="mesh" rgba="0.75294 0.75294 0.75294 1" mesh="link3"/>

            <body name="link4" quat="0.6644620097 0.6644644504 0.2418437534 -0.2418446418" gravcomp="1">
              <inertial pos="-0.0000880700 -0.0393530800 -0.0030127800" mass="1.0434241800" fullinertia="0.0034578700 0.0007773600 0.0034520600 0.0000048700 0.0000023400 0.0001205500"/>
              <joint name="joint4" pos="0 0 0" axis="0 0 1" range="-2.5307 0.08726"/>
              <geom type="mesh" rgba="0.75294 0.75294 0.75294 1" mesh="link4"/>

              <body name="link5" pos="0 -0.32905 0" quat="0.4999981634 0.5 0.5 -0.5000018366" gravcomp="1">
