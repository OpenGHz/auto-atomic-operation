                    <joint name="joint7" pos="0 0 0" axis="0 0 1" range="-1.5708 1.2217"/>
                    <geom type="mesh" rgba="0.75294 0.75294 0.75294 1" mesh="link7"/>

                    <body name="umi_gripper_mount" pos="-0.062 0 0" quat="-2.597343467e-06 2.597353008e-06 -0.7071080799 0.7071054825" gravcomp="1">
                      <geom type="mesh" rgba="0.75294 0.75294 0.75294 1" mesh="tool" contype="0" conaffinity="0"/>
                      <site name="tool_site" pos="0 0 0" size="0.005" type="sphere"/>
                      <site name="umi_gripper_mount_site" pos="0 0 0" size="0.006" type="sphere" rgba="1 0 0 1"/>

                      <body name="tcp_frame" pos="0.1601 0 0" quat="1 0 0 0" gravcomp="1">
                        <!-- <site name="tcp_site" pos="0 0 0" quat="1 0 0 0" size="0.001" type="sphere" rgba="0 1 0 1"/> -->
                        <!-- eef_pose is the IK / task target. Place it at the
                             actual finger-pad mid-line of the umi_gripper_v3
                             so task offsets follow the same TCP-relative
                             convention as the xf9600 gripper (pad ~2 cm
                             behind TCP at the home pose). -->
                        <site name="eef_pose" pos="-0.0115 0 0" quat="1 0 0 0" size="0.001" type="sphere" rgba="0 0 1 1"/>
                      </body>

                      <body name="umi_gripper_base_mount" quat="1 0 0 0" gravcomp="1">
                        <attach model="umi_gripper_v3" prefix="eef_"/>
                      </body>
                    </body>
                  </body>
                </body>
