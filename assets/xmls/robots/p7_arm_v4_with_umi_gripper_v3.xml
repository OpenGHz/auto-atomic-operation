  <actuator>
    <position name="joint1" joint="joint1" kp="400" kv="40" ctrlrange="-2.9669 2.9669"/>
    <position name="joint2" joint="joint2" kp="400" kv="40" ctrlrange="-2.8798 0.83775"/>
