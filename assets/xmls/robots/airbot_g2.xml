<mujoco model="airbot_g2">
  <compiler angle="radian" balanceinertia="true" meshdir="../../meshes/airbot_g2"/>

  <default>
    <default class="g2">
      <joint type="slide" damping="1" frictionloss="0.2" armature="0.01"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="0"/>
      </default>
      <default class="collision">
        <geom contype="1" conaffinity="1" group="3" friction="1.2 0.05 0.01"/>
      </default>
    </default>
  </default>

  <asset>
    <mesh name="g2_base_mesh" file="base_link.STL"/>
    <mesh name="g2_left_mesh" file="left_link.STL"/>
    <mesh name="g2_right_mesh" file="right_link.STL"/>
  </asset>

  <actuator>
    <position name="g2_driver" joint="left_joint" kp="5000" kv="100"
              ctrlrange="-0.0366 0" forcerange="-10 10"/>
  </actuator>

  <equality>
    <joint joint1="left_joint" joint2="right_joint" polycoef="0 1 0 0 0"
           solimp="0.999 0.9999 0.001" solref="0.002 1"/>
  </equality>

  <worldbody>
    <body name="base_link" childclass="g2">
      <inertial pos="0.000059308 -0.00003262 0.041814" mass="0.488"
                fullinertia="0.00115523 0.00137334 0.00042051 -0.000002 0.00000022 -0.00000087"/>
      <geom mesh="g2_base_mesh" class="visual"/>
      <camera name="wrist_cam" pos="0 -0.035 0.09" quat="0.5 0.5 -0.5 0.5" fovy="70"/>
      <body name="left_link" pos="0 0 0.0705" quat="0.707105 0 -0.707108 0">
        <inertial pos="0.018307 0.0000059636 0.012505" mass="0.054004"
                  fullinertia="0.0000246 0.0000478 0.00004892 0 0.00000755 0"/>
        <joint name="left_joint" axis="0 0 -1" range="-0.0366 0"/>
        <geom mesh="g2_left_mesh" class="visual"/>
        <geom name="left_finger_pad" type="box" pos="0.0815 0 0.00135"
              size="0.004 0.0012 0.0011" margin="0.0005" class="collision"
              group="0" rgba="0 1 0 0.35"/>
      </body>
      <body name="right_link" pos="0 0 0.0705" quat="-0.00000259734 0.707105 0.00000259735 0.707108">
        <inertial pos="0.018307 -0.00000068572 0.012505" mass="0.054004"
                  fullinertia="0.0000246 0.0000478 0.00004892 0 -0.00000755 0"/>
        <joint name="right_joint" axis="0 0 -1" range="-0.0366 0"/>
        <geom mesh="g2_right_mesh" class="visual"/>
        <geom name="right_finger_pad" type="box" pos="0.0815 0 0.00135"
              size="0.004 0.0012 0.0011" margin="0.0005" class="collision"
              group="0" rgba="0 1 0 0.35"/>
      </body>
      <site name="tcp" pos="0 0 0.236" quat="0.5 0.5 -0.5 0.5" size="0.006"/>
    </body>
  </worldbody>
</mujoco>
