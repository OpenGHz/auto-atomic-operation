<mujoco model="rack_plate_plate_cam">
  <!-- Sim-only camera module for the rack-plate scene.

       MuJoCo cameras live on a body in the composed model, so a scene-object
       camera has to be authored somewhere in the MJCF; keeping it in this
       module instead of the migrated `demo.xml` leaves the plate body
       byte-identical to its source asset and lets a task opt in per camera
       configuration.  Ownership and mount frame come from YAML:
       `env.cameras[].role: object` with `parent_frame: object` makes
       `MujocoBasis._mount_object_cameras` re-parent the camera onto the plate
       body, which turns the pose below into a plate-local install offset and
       makes MuJoCo track the plate for free.

       Authored pose: 0.25 m out along the plate face normal (object +X, the
       axis the UMI jaws pinch) looking back at the plate, with the plate's +Z
       as image up (`xyaxes` x=(0 1 0), y=(0 0 1) ⇒ the camera looks along
       -Z_cam = -X_object).  The framing therefore depends on the plate frame
       only, not on how the plate happens to be leaned in the stand or where
       randomization floats it. -->
  <worldbody>
    <camera name="plate_cam" pos="0.25 0 0" xyaxes="0 1 0 0 0 1" fovy="60"/>
  </worldbody>
</mujoco>
