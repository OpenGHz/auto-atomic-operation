<mujoco model="aao_microwave_sweet_potato">
  <compiler angle="radian" meshdir="../../../meshes" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <visual>
    <global azimuth="120" elevation="-25"/>
    <map znear="0.001"/>
  </visual>
  <default>
    <geom friction="1.0 0.02 0.002" solref="0.01 1"/>
    <!-- Source visual class: render-only, massless. -->
    <default class="microwave_visual">
      <geom type="mesh" contype="0" conaffinity="0" mass="0" group="0"/>
    </default>
    <!-- Source collision class: hull meshes with density 250 kg/m^3, hidden
         in group 3 (enable it in the viewer to inspect the hulls). -->
    <default class="microwave_hull">
      <geom type="mesh" density="250" friction="0.8 0.02 0.002" condim="4"
            group="3" rgba="0.2 0.8 0.2 0.25"/>
    </default>
  </default>

  <asset>
    <include file="includes/microwave_assets.xml"/>
    <!-- maxhullvert bounds the collision hull of the 135k-vertex scan; the
         visual geom still renders the full mesh. -->
    <mesh name="sweet_potato_mesh"
          file="microwave_sweet_potato/sweet_potato/sweet_potato.obj"
          inertia="convex" maxhullvert="128"/>
    <material name="floor" rgba="0.22 0.24 0.28 1"/>
    <material name="counter" rgba="0.55 0.42 0.30 1"/>
    <material name="target" rgba="0.15 0.75 0.25 0.65"/>
    <!-- Median of the scan's per-vertex colours; MuJoCo ignores OBJ vertex colours. -->
    <material name="sweet_potato_skin" rgba="0.416 0.290 0.278 1"
              specular="0.2" shininess="0.2"/>
  </asset>

  <worldbody>
    <light name="microwave_light" pos="0 -0.4 1.6" dir="0 0.25 -1"
           diffuse="0.9 0.9 0.9"/>
    <!-- Front camera: looking from -Y into the open microwave. -->
    <camera name="env1_cam" pos="0.08 -0.80 0.52"
            xyaxes="0.998812 0.048723 0 -0.021341 0.437483 0.898974" fovy="50"/>
    <!-- Side camera: looking from the front-right toward the counter. -->
    <camera name="env0_cam" pos="0.85 -0.25 0.50"
            xyaxes="0.316228 0.948683 0 -0.385743 0.128581 0.913602" fovy="50"/>
    <geom name="floor" type="plane" size="1.2 1.2 0.05" material="floor"/>

    <!-- Counter: half-height 0.03 on the floor, top surface at z=0.06. -->
    <body name="counter" pos="0 0.04 0.03">
      <geom name="counter_top" type="box" size="0.42 0.34 0.03" material="counter"/>
    </body>

    <!--
      Fixed microwave (no joint).  Its source frame is centred on the cabinet;
      the lowest foot is 0.1274967 m below the origin, so the feet rest on the
      counter top.  Door faces -Y and swings open toward -X.
    -->
    <body name="microwave" pos="0.04 0.13 0.1874967">
      <include file="includes/microwave_common.xml"/>

      <!--
        Placement frame on the dished turntable, a child of the microwave so
        it moves with any future cabinet randomization.  The origin is the
        settled sweet-potato origin after a gentle release (dish centre is at
        about local (-0.035, 0.08)); local +X points at the back wall, which
        is the tuber long axis at rest.  Roll about that axis is not encoded:
        the resting roll depends on the scan's asymmetric cross-section.
      -->
      <body name="microwave_target" pos="-0.030 0.0856 -0.0165" quat="0.707106781 0 0 0.707106781">
        <!-- Render-only marker on the dish surface (local z -0.0385). -->
        <geom name="microwave_target_pad" type="box" pos="0 0 -0.0215"
              size="0.012 0.012 0.0005" material="target"
              contype="0" conaffinity="0"/>
        <site name="microwave_target_site" pos="0 0 0" size="0.006"
              rgba="0.15 1 0.25 1"/>
      </body>
    </body>

    <!--
      Sweet potato at rest on the counter, front-right of the microwave.  The
      body frame is the scan frame: local +X is the long axis, pointing at the
      microwave (+Y), with the blunter -X end toward the operator.  The scan
      is not stable "local +Z up"; this is its settled pose (about 31 deg of
      roll about the long axis), so the task does not start with a rolling
      object.
    -->
    <body name="sweet_potato" pos="0.20 -0.17 0.0821373"
          quat="0.676745777 -0.194708893 -0.187001594 0.684933577">
      <freejoint name="sweet_potato_joint"/>
      <site name="sweet_potato_site" pos="0 0 0" size="0.004" rgba="1 0.6 0.2 0"/>
      <geom name="sweet_potato_visual" type="mesh" mesh="sweet_potato_mesh"
            material="sweet_potato_skin" mass="0" contype="0" conaffinity="0"/>
      <geom name="sweet_potato_collision" type="mesh" mesh="sweet_potato_mesh"
            mass="0.2" condim="4" rgba="0 0 0 0"/>
    </body>
  </worldbody>

  <!-- The cabinet and door hulls overlap around the modeled hinge seam. -->
  <contact>
    <exclude body1="microwave" body2="microwave_door"/>
  </contact>
</mujoco>
