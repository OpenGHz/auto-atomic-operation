<mujoco model="aao_dishwasher_plate">
  <compiler angle="radian" meshdir="../../../meshes" texturedir="../../../meshes"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <visual>
    <global azimuth="135" elevation="-20"/>
  </visual>
  <default>
    <joint damping="25" armature="0.02"/>
    <geom friction="1.0 0.02 0.002" solref="0.01 1"/>
    <position kp="600" kv="45"/>
  </default>

  <asset>
    <mesh name="plate2_mesh" file="dishwasher_plate/plate2/plate2.obj"/>
    <include file="includes/dishwasher031_assets.xml"/>
    <material name="floor" rgba="0.20 0.22 0.25 1"/>
    <material name="source_table" rgba="0.42 0.30 0.20 1"/>
    <material name="robot" rgba="0.25 0.55 0.85 1"/>
    <material name="target" rgba="0.15 0.75 0.25 0.65"/>
    <material name="plate" rgba="0.88 0.74 0.42 1"/>
  </asset>

  <worldbody>
    <light pos="0 -0.3 1.4" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>
    <camera name="placement_camera" pos="0 -1.4 0.8"
            xyaxes="1 0 0 0 0.492 0.870" fovy="52"/>
    <geom name="floor" type="plane" pos="0 0 -0.478"
          size="1.0 1.2 0.05" material="floor"/>

    <!--
      The canonical placement scene consumes one shared articulated dishwasher
      definition. Joint refs preserve the placement-ready default: door open,
      upper rack extracted, and lower rack retracted.
    -->
    <body name="dishwasher">
      <include file="includes/dishwasher031_common.xml"/>

      <!-- The extracted upper rack uses mesh-derived local wire proxies. -->
      <body name="dishwasher_rack1" pos="0 -0.33 0">
        <include file="includes/dishwasher031_rack1_articulation.xml"/>
        <!-- Generated geometry and task contact policy are versioned separately. -->
        <include file="includes/dishwasher031_rack1_vertical_collision.xml"/>

        <!--
          Rack-local stable cradle center.  In the X-Z section this is the
          equal-distance circle center for the plate radius plus the 2.5 mm
          wire half-width against support wires c038 and c050.
        -->
        <body name="dishwasher_rack1_target" pos="-0.03487368 -0.0236405 0.20811805">
          <geom name="target_pad" type="box" pos="0 0 -0.120665074"
                size="0.012 0.012 0.0005" material="target"
                contype="0" conaffinity="0"/>
          <site name="dishwasher_rack1_target_site" pos="0 0 0"
                size="0.006" rgba="0.15 1 0.25 1"/>
        </body>
      </body>
    </body>

    <!-- Planner-only floor guard prevents trajectories below the appliance and rack. -->
    <geom name="planner_floor_guard" type="box" pos="0 -0.20 -0.035"
          size="0.75 0.90 0.025" rgba="0 0 0 0" contype="0" conaffinity="0"/>

    <!--
      One-sided source table: its -X edge stops 80.2 mm inside the plate rim,
      leaving the -X edge accessible to the gripper while supporting the
      plate center of mass and the complete +X side.
    -->
    <geom name="source_table" type="box" pos="-0.405 -0.360 0.180560989"
          size="0.085 0.160 0.030" material="source_table"/>

    <!-- plate2 is horizontal: the mesh and collision-cylinder normal is +Z. -->
    <body name="plate2" pos="-0.450 -0.360 0.223671074">
      <freejoint name="plate2_joint"/>
      <site name="plate2_site" pos="0 0 0" size="0.006" rgba="1 0.75 0.2 1"/>
      <geom name="plate2_visual" type="mesh" mesh="plate2_mesh"
            pos="0.000074340 0.000103035 0.000636195"
            material="plate" mass="0" contype="0" conaffinity="0"/>
      <geom name="plate2_collision" type="cylinder" size="0.120165074 0.013110085"
            mass="0.35" rgba="0 0 0 0" condim="6" friction="1.0 0.1 0.02"/>
    </body>
  </worldbody>

  <actuator>
    <include file="includes/dishwasher031_actuators.xml"/>
  </actuator>
</mujoco>
